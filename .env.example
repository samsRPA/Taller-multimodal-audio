# Copia este archivo como .env (en la raíz del repositorio) y pon tu clave.
# El .env está en el .gitignore: nunca lo subas al repositorio.
GROQ_API_KEY=gsk_...

# Opcional: modelo con visión (puntos 1.1 a 1.4)
VISION_MODEL=qwen/qwen3.8-27b
# Opcional: modelo sin visión (se usa para provocar el error del punto 1.4)
LLM_MODEL=openai/gpt-oss-20b
# Opcional: modelo de transcripción de audio (Parte 2)
AUDIO_MODEL=whisper-large-v3-turbo
